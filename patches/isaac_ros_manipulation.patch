@@ -0,0 +1,59 @@
+"""Canonicalize a detected axial object pose without losing its end direction."""
+
+from __future__ import annotations
+
+from typing import Sequence
+
+import numpy as np
+
+
+def canonicalize_axial_pose(
+    world_pose_mesh: np.ndarray,
+    *,
+    half_height_m: float,
+    top_axis_in_mesh: Sequence[float],
+    minimum_vertical_axis: float = 0.75,
+) -> tuple[np.ndarray, float]:
+    """Return a world-aligned object pose that preserves detected top/bottom.
+
+    FoundationPose yaw is unstable for a rotationally symmetric can. Its textured
+    top-versus-bottom axis is still useful, so this keeps that binary sign while
+    snapping the object frame to either identity (upright) or 180 degrees about X
+    (bottom-up). The object origin is the semantic bottom-center, not whichever
+    face currently touches the table.
+    """
+    pose = np.asarray(world_pose_mesh, dtype=float)
+    if pose.shape != (4, 4) or not np.all(np.isfinite(pose)):
+        raise ValueError("world_pose_mesh must be a finite 4x4 matrix")
+    if not np.isfinite(half_height_m) or half_height_m <= 0.0:
+        raise ValueError("half_height_m must be positive")
+    if not 0.0 < minimum_vertical_axis <= 1.0:
+        raise ValueError("minimum_vertical_axis must be in (0, 1]")
+
+    mesh_axis = np.asarray(top_axis_in_mesh, dtype=float)
+    if mesh_axis.shape != (3,) or not np.all(np.isfinite(mesh_axis)):
+        raise ValueError("top_axis_in_mesh must contain three finite values")
+    axis_norm = float(np.linalg.norm(mesh_axis))
+    if axis_norm <= 1.0e-9:
+        raise ValueError("top_axis_in_mesh must be nonzero")
+    mesh_axis /= axis_norm
+
+    world_axis = pose[:3, :3] @ mesh_axis
+    world_axis_norm = float(np.linalg.norm(world_axis))
+    if world_axis_norm <= 1.0e-9:
+        raise ValueError("detected rotation produced a zero object axis")
+    axis_z = float(world_axis[2] / world_axis_norm)
+    if abs(axis_z) < minimum_vertical_axis:
+        raise ValueError(
+            "detected object axis is not vertical enough: "
+            f"axis_z={axis_z:.3f}, required |axis_z|>={minimum_vertical_axis:.3f}"
+        )
+
+    direction = 1.0 if axis_z > 0.0 else -1.0
+    canonical = np.eye(4, dtype=float)
+    if direction < 0.0:
+        canonical[1, 1] = -1.0
+        canonical[2, 2] = -1.0
+    canonical[:2, 3] = pose[:2, 3]
+    canonical[2, 3] = pose[2, 3] - direction * half_height_m
+    return canonical, axis_z
