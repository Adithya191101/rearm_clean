+# Per-class FoundationPose mesh conventions for rotationally symmetric objects.
+#
+# FoundationPose returns the CAD mesh frame. For the soup-can mesh, +Y points
+# toward the labeled top. The grasp set instead uses a semantic bottom-center
+# origin with +Z pointing toward that top.
+#
+# Yaw about a cylinder's axis is unstable, so it is canonicalized. The axial
+# sign is not discarded: the texture distinguishes the two ends, and retaining
+# that sign is what lets a bottom-up can produce a rolled grasp and an upright
+# placement. A nearly horizontal estimate is rejected rather than silently
+# converted into a plausible but wrong grasp.
+#
+# The legacy GT bridge already supplies the grasp convention and is not listed.
+_HALF_H_SOUP_CAN = 0.0505
+_SYMMETRIC_AXIAL_OBJECTS = {
+    # class_id -> (half-height, top axis expressed in the FoundationPose mesh)
+    'soup can': (_HALF_H_SOUP_CAN, (0.0, 1.0, 0.0)),
+}
+
+
+# FoundationPose and grasp files use different object frames:
