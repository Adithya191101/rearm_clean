+
+"""Structural regressions for attachment, planning, and release ordering."""
+
+import os
+
+from ament_index_python.packages import get_package_share_directory
+from isaac_ros_manipulation_orchestration.utils.behavior_tree_config import (
+    BehaviorTreeConfigInitializer,
+)
+from isaac_ros_manipulation_pick_and_place.behavior_trees.motion_subtrees.motion_workflows import (
+    create_motion_subtree,
+)
+
+
+def _motion_tree():
+    package = 'isaac_ros_manipulation_pick_and_place'
+    params = os.path.join(
+        get_package_share_directory(package),
+        'params',
+        'multi_object_pick_and_place_behavior_tree_params.yaml',
+    )
+    return create_motion_subtree(
+        BehaviorTreeConfigInitializer(
+            behavior_tree_params_file=params,
+            package_name=package,
+        )
+    )
+
+
+def test_drop_planning_waits_for_post_attachment_joint_state():
+    child_names = [child.name for child in _motion_tree().children]
+    assert child_names.index('Retry Attach Object') < child_names.index(
+        'Wait for Fresh Joint State')
+    assert child_names.index('Wait for Fresh Joint State') < child_names.index(
+        'Drop')
+
+
+def test_drop_detaches_before_opening_the_jaws():
+    motion = _motion_tree()
+    drop = next(child for child in motion.children if child.name == 'Drop')
+    child_names = [child.name for child in drop.children]
+    assert child_names.index('Detach Object') < child_names.index(
+        'Open Gripper Subtree')
+    assert 'Detach Object' not in [child.name for child in motion.children]
