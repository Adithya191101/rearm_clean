+"""Tests for the post-attachment fresh-joint-state gate."""
+
+import time
+
+from isaac_ros_manipulation_orchestration.behaviors.motion_behaviors import (
+    WaitForFreshJointState,
+)
+from isaac_ros_manipulation_test_utils.orchestration.behavior_base import BehaviorTestBase
+from isaac_ros_manipulation_test_utils.orchestration.timeouts import (
+    get_node_startup_delay,
+)
+from launch_ros.actions import Node
+import py_trees
+import pytest
+import rclpy
+from sensor_msgs.msg import JointState
+
+
+JOINT_STATES_TOPIC = '/wait_for_fresh_joint_state_test'
+
+
+class WaitForFreshJointStateTest(BehaviorTestBase):
+    """Verify that only samples received after initialise satisfy the gate."""
+
+    def setUp(self):
+        super().setUp()
+        self.publisher = self.node.create_publisher(
+            JointState, JOINT_STATES_TOPIC, 10)
+
+    def tearDown(self):
+        self.node.destroy_publisher(self.publisher)
+        super().tearDown()
+
+    def _publish_valid_state(self):
+        msg = JointState()
+        msg.name = ['joint1']
+        msg.position = [0.0]
+        self.publisher.publish(msg)
+        rclpy.spin_once(self.node, timeout_sec=0.1)
+
+    def test_requires_two_samples_newer_than_initialise(self):
+        behavior = WaitForFreshJointState(
+            name='Wait for Fresh Joint State',
+            topic_name=JOINT_STATES_TOPIC,
+            timeout_sec=2.0,
+            minimum_samples=2,
+        )
+        behavior.setup(node=self.node)
+        try:
+            deadline = time.monotonic() + 1.0
+            while (self.publisher.get_subscription_count() == 0
+                   and time.monotonic() < deadline):
+                rclpy.spin_once(self.node, timeout_sec=0.05)
+            self.assertGreater(self.publisher.get_subscription_count(), 0)
+
+            self._publish_valid_state()  # stale: before initialise
+            behavior.tick_once()
+            self.assertEqual(behavior.status, py_trees.common.Status.RUNNING)
+
+            self._publish_valid_state()
+            behavior.tick_once()
+            self.assertEqual(behavior.status, py_trees.common.Status.RUNNING)
+
+            self._publish_valid_state()
+            behavior.tick_once()
+            self.assertEqual(behavior.status, py_trees.common.Status.SUCCESS)
+        finally:
+            behavior.shutdown()
+
+
+@pytest.mark.rostest
+def generate_test_description():
+    """Keep launch alive while the in-process behavior test runs."""
+    keep_alive = Node(
+        package='tf2_ros',
+        executable='static_transform_publisher',
+        name='fresh_joint_state_test_keep_alive',
+        output='screen',
+        arguments=['0', '0', '0', '0', '0', '0', 'world', 'base_link'],
+    )
+    return WaitForFreshJointStateTest.generate_test_description(
+        run_test=True,
+        use_sim_time=False,
+        nodes=[keep_alive],
+        node_startup_delay=get_node_startup_delay(has_external_nodes=True),
+    )
