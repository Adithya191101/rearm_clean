+    workflow_status = MultiObjectPickAndPlace.Result.UNKNOWN
+
+    def exists(self, key):
+        return key == 'workflow_status'
+
+
+class _MutableBlackboard(SimpleNamespace):
+
+    def exists(self, key):
+        return hasattr(self, key)
+
+
+def test_new_goal_clears_terminal_workflow_state_before_resuming_tree():
+    orchestrator = object.__new__(MultiObjectPickPlaceOrchestrator)
+    orchestrator.blackboard = _MutableBlackboard(
+        workflow_status=MultiObjectPickAndPlace.Result.SUCCESS,
+        object_info_cache={0: {'status': 'DONE'}},
+        next_object_id=deque([0]),
+        selected_object_id=0,
+        active_obj_id=0,
+        goal_drop_pose=object(),
+        abort_motion=True,
+        workflow_summary='old result',
+        workflow_feedback_queue=deque(['old feedback']),
+    )
+    target_poses = [object()]
+
+    orchestrator._prepare_blackboard_for_goal(
+        MultiObjectPickAndPlace.Goal.SINGLE_BIN,
+        target_poses,
+        [],
+    )
+
+    assert orchestrator.blackboard.object_info_cache is None
+    assert orchestrator.blackboard.next_object_id == deque()
+    assert orchestrator.blackboard.selected_object_id is None
+    assert orchestrator.blackboard.active_obj_id is None
+    assert orchestrator.blackboard.goal_drop_pose is None
+    assert orchestrator.blackboard.target_poses is target_poses
+    assert orchestrator.blackboard.workflow_status == (
+        MultiObjectPickAndPlace.Result.UNKNOWN
+    )
+
+
+def test_first_goal_preserves_pose_estimation_staged_before_goal_arrival():
+    staged_cache = {0: {'status': 'READY_FOR_MOTION'}}
+    orchestrator = object.__new__(MultiObjectPickPlaceOrchestrator)
+    orchestrator.blackboard = _MutableBlackboard(
+        workflow_status=MultiObjectPickAndPlace.Result.UNKNOWN,
+        object_info_cache=staged_cache,
+        next_object_id=deque([0]),
+        selected_object_id=0,
+        active_obj_id=None,
+        goal_drop_pose=None,
+        abort_motion=False,
+        workflow_summary='',
+        workflow_feedback_queue=deque(),
+    )
+
+    orchestrator._prepare_blackboard_for_goal(
+        MultiObjectPickAndPlace.Goal.SINGLE_BIN,
+        [object()],
+        [],
+    )
+
+    assert orchestrator.blackboard.object_info_cache is staged_cache
+    assert orchestrator.blackboard.next_object_id == deque([0])
+
+
+def test_execute_callback_releases_gil_while_workflow_is_running():
+    orchestrator = object.__new__(MultiObjectPickPlaceOrchestrator)
+    orchestrator.logger = Mock()
+    orchestrator.blackboard = _UnknownStatusBlackboard()
+    orchestrator._shutdown_event = Mock()
+    orchestrator._shutdown_event.is_set.side_effect = [False, True]
+    orchestrator.is_orchestrator_busy = True
+
+    goal_handle = Mock()
+    goal_handle.request = SimpleNamespace(
+        mode=MultiObjectPickAndPlace.Goal.SINGLE_BIN,
+        target_poses=SimpleNamespace(poses=[]),
+        class_ids=[],
+    )
+    goal_handle.is_cancel_requested = False
+
+    with patch(RCLPY_OK, return_value=True):
+        orchestrator.execute_callback(goal_handle)
+
+    orchestrator._shutdown_event.wait.assert_called_once_with(timeout=0.01)
+    goal_handle.abort.assert_called_once()
+
+
+def test_normal_mode_releases_gil_while_background_threads_run():
+    orchestrator = object.__new__(MultiObjectPickPlaceOrchestrator)
+    orchestrator.logger = Mock()
+    orchestrator.tree = Mock()
+    orchestrator._shutdown_event = Mock()
+    orchestrator._shutdown_event.is_set.side_effect = [False, True]
+    orchestrator.shutdown = Mock()
+
+    with patch(RCLPY_OK, return_value=True):
+        orchestrator._run_normal_mode()
+
+    orchestrator.tree.tick_tock.assert_called_once_with(10.0)
+    orchestrator._shutdown_event.wait.assert_called_once_with(timeout=0.1)
+    orchestrator.shutdown.assert_called_once()
