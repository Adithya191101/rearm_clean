+"""Regressions for stopping the tree after a terminal workflow result."""
+
+from types import SimpleNamespace
+
+from isaac_ros_manipulation_interfaces.action import MultiObjectPickAndPlace
+from isaac_ros_manipulation_pick_and_place.behavior_trees.multi_object_pick_and_place_bt import (
