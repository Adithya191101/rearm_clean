+)
+import pytest
+
+
+class _Blackboard(SimpleNamespace):
+
+    def exists(self, key):
+        return hasattr(self, key)
+
+
+def test_unknown_workflow_status_keeps_tree_running():
+    blackboard = _Blackboard(
+        workflow_status=MultiObjectPickAndPlace.Result.UNKNOWN)
+    assert check_workflow_pending(blackboard)
+
+
+@pytest.mark.parametrize(
+    'status',
+    [
+        MultiObjectPickAndPlace.Result.SUCCESS,
+        MultiObjectPickAndPlace.Result.PARTIAL_SUCCESS,
+        MultiObjectPickAndPlace.Result.FAILED,
+        MultiObjectPickAndPlace.Result.INCOMPLETE,
+    ],
+)
+def test_terminal_workflow_status_stops_tree(status):
+    assert not check_workflow_pending(_Blackboard(workflow_status=status))
+
+
+def test_missing_workflow_status_stops_tree():
+    assert not check_workflow_pending(_Blackboard())
