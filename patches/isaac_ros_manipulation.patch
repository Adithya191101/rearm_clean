+"""Behavior that gates planning on a joint state received after activation."""
+
+import math
+import threading
+import time
+
+import py_trees
+from sensor_msgs.msg import JointState
+
+
+class WaitForFreshJointState(py_trees.behaviour.Behaviour):
+    """Wait for a structurally valid joint-state sample newer than initialise."""
+
+    def __init__(
+        self,
+        name: str,
+        topic_name: str = '/joint_states',
+        timeout_sec: float = 5.0,
+        minimum_samples: int = 2,
+    ):
+        super().__init__(name)
+        self._topic_name = topic_name
+        self._timeout_sec = float(timeout_sec)
+        self._minimum_samples = int(minimum_samples)
+        if self._minimum_samples < 1:
+            raise ValueError('minimum_samples must be at least one')
+        self._lock = threading.Lock()
+        self._sample_generation = 0
+        self._start_generation = 0
+        self._start_time = 0.0
+        self.node = None
+        self._subscription = None
+
+    def setup(self, **kwargs):
+        """Create the subscription using the behavior tree's ROS node."""
+        try:
+            self.node = kwargs['node']
+        except KeyError as error:
+            raise KeyError(
+                f"didn't find ros2 node in setup's kwargs for {self.name}"
+            ) from error
+        self._subscription = self.node.create_subscription(
+            JointState, self._topic_name, self._on_joint_state, 10)
+        return True
+
+    def initialise(self):
+        """Snapshot the generation so pre-attachment samples cannot pass."""
+        with self._lock:
+            self._start_generation = self._sample_generation
+        self._start_time = time.monotonic()
+
+    def update(self):
+        """Return success only after a newer valid sample is observed."""
+        with self._lock:
+            fresh_samples = self._sample_generation - self._start_generation
+            fresh = fresh_samples >= self._minimum_samples
+        if fresh:
+            self.node.get_logger().info(
+                f'[{self.name}] Received {fresh_samples} fresh joint states '
+                f'after attachment')
+            return py_trees.common.Status.SUCCESS
+
+        elapsed = time.monotonic() - self._start_time
+        if elapsed >= self._timeout_sec:
+            self.node.get_logger().error(
+                f'[{self.name}] No fresh joint state on {self._topic_name} '
+                f'within {self._timeout_sec:.1f}s')
+            return py_trees.common.Status.FAILURE
+        return py_trees.common.Status.RUNNING
+
+    def shutdown(self):
+        """Destroy the subscription when the tree shuts down."""
+        if self.node is not None and self._subscription is not None:
+            self.node.destroy_subscription(self._subscription)
+            self._subscription = None
+
+    def _on_joint_state(self, msg: JointState):
+        if not msg.name or len(msg.name) != len(msg.position):
+            return
+        if not all(math.isfinite(float(position)) for position in msg.position):
+            return
+        with self._lock:
+            self._sample_generation += 1
