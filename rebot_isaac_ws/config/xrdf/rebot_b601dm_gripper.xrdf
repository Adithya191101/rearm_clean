# Validated simulation artifact; do not hand-edit.
#
# cuMotion / cuRobo XRDF for the reBot B601-DM, gripper model.
# Pairs with urdf/generated/rebot_b601dm_cumotion_gripper.urdf.
#
# SIM PROFILE ONLY. The camera bracket pose comes from config/extrinsics_sim.yaml.
# config/extrinsics_real.yaml is deliberately NOT read: its camera_link offset is
# a placeholder identity pending hand-eye calibration, and spheres built from an
# uncalibrated extrinsic would encode a number nobody has measured.
#
# Every sphere was computed by voxelising each link's collision mesh in its own
# frame and covering it deepest-voxel-first, with
# each radius capped at that voxel's distance to the part's surface plus a fixed
# 12 mm -- which BOUNDS how far a sphere can reach past real material instead of
# merely hoping it does not. The minimal runtime overlay keeps this reviewed
# output and omits the one-off authoring utilities.
#
# THE JAWS ARE NOT CSPACE JOINTS. cspace is joint1..joint6 only. cuMotion LOCKS
# every controlled joint absent from cspace at its default_joint_positions value,
# so gripper_joint1 is held at the fully-open 0.0715 m and the guarded volume is
# the jaws' widest envelope. Only gripper_joint1 is listed: gripper_joint2 is its
# MIMIC FOLLOWER and cuMotion rejects the URDF import if a follower is set
# explicitly. The follower still reaches 0.0715 m via the mimic, so both jaws are
# locked open.
#
# SPHERES COVER MATERIAL, NOT THE GRASPING HOLLOW. The collision hulls are one
# convex hull per link and a jaw's hull BRIDGES the gap between its carriage rail
# and its finger body -- 63.9% of the gripper_left hull is void, and at the worst
# cross-section 95.4% is void. Spheres fitted to that hull sit exactly where a
# grasped object must go, so every grasp is reported as a collision before the jaws
# touch anything: rebuilding these jaws from their hulls measurably intrudes
# 18.2 mm into the can's grasp volume, against -6.5 mm of clearance here.
#
# THE COVERAGE TARGET IS meshes/visual/*.STL FOR EVERY LINK, not just the jaws. An
# earlier revision made the jaws the exception, which was the wrong shape of fix:
# FOUR ARM LINKS ARE EMPTIER THAN THE JAWS (link1 79.7% void, link4 70.5%,
# gripper_link 68.7%, link3 67.4%, against the jaws' 63.9%), so covering their
# hulls forced radii large enough to invent base_link<->gripper self-collisions
# the real parts do not have. The jaws keep one extra measure -- rail and finger
# are covered as SEPARATE solids -- so no jaw sphere's radius is ever set across
# the empty gap between them.
format: xrdf
format_version: 1.0
modifiers:
- {set_base_frame: base_link}
- add_frame:
    frame_name: camera_mount
    parent_frame_name: link6
    joint_name: camera_mount_joint
    joint_type: FIXED
    fixed_transform:
      position: [0.05, 0.0, 0.06]
      orientation:
        w: 1.0
        xyz: [0.0, 0.0, 0.0]
default_joint_positions: {joint1: -0.6, joint2: -0.75, joint3: -0.75, joint4: 0.0, joint5: 0.0, joint6: 0.0,
  gripper_joint1: 0.0715}
cspace:
  joint_names: [joint1, joint2, joint3, joint4, joint5, joint6]
  acceleration_limits: [25.0, 25.0, 25.0, 15.0, 15.0, 15.0]
  jerk_limits: [500.0, 500.0, 500.0, 300.0, 300.0, 300.0]
tool_frames: [gripper_tcp]
collision:
  geometry: collision_spheres
  buffer_distance: {base_link: 0.005, link1: 0.005, link2: 0.005, link3: 0.005, link4: 0.005, link5: 0.005,
    link6: 0.005, camera_mount: 0.005, gripper_link: 0.005, gripper_left: 0.0, gripper_right: 0.0}
self_collision:
  geometry: collision_spheres
  buffer_distance: {base_link: 0.002, link1: 0.002, link2: 0.002, link3: 0.002, link4: 0.002, link5: 0.002,
    link6: 0.002, camera_mount: 0.002, gripper_link: 0.002, gripper_left: 0.001, gripper_right: 0.001}
  ignore:
    base_link: [link1, link2]
    camera_mount: [gripper_left, gripper_link, link4, link5, link6]
    gripper_left: [gripper_link]
    gripper_link: [gripper_right, link4, link5, link6]
    link1: [link2, link3, link4, link5]
    link2: [link3, link4, link5]
    link3: [link4, link5]
    link4: [link5, link6]
    link5: [link6]
geometry:
  collision_spheres:
    spheres:
      base_link:
      - center: [-0.003, 0.0, 0.0465]
        radius: 0.0375
      - center: [-0.0285, -0.027, 0.015]
        radius: 0.02525
      - center: [-0.0285, 0.027, 0.015]
