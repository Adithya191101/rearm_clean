  <!--
      joint6 origin is the WITH-GRIPPER value (0.023692), which is the canonical
      one. Seeed's fixend URDF uses 0.028008 paired with a 0.15539 end offset;
      those two cancel to within 4 um of this model's 0.023692 + 0.15971, because
      the joint6 origin delta rotates onto link6 -Z through rpy=(0, 1.5708, 0).
      The real difference between the two upstream models is a 180-degree flip
      about X, not a translation — see docs/KDR-001-kinematic-frames.md.
    -->
  <joint name="joint6" type="revolute">
    <origin rpy="0 1.5708 0" xyz="0.023692 0 0.04"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit effort="7" lower="-3.14" upper="3.14" velocity="3.0"/>
  </joint>
