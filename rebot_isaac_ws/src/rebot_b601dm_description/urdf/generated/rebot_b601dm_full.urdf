  <joint name="gripper_joint2" type="prismatic">
    <origin rpy="0 0 1.5708" xyz="-0.042091 -2.7531E-05 1.3031E-05"/>
    <parent link="gripper_link"/>
    <child link="gripper_right"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" lower="0.0" upper="0.0715" velocity="0.2"/>
    <!--
        AUTHORED, not corrected: upstream has no <mimic> anywhere. Without it the
        gripper is 2 DoF and every consumer (MoveIt, cuMotion, RViz) can command
        asymmetric jaws that the single-motor hardware cannot produce.

        multiplier="+1.0" is correct despite the jaws moving in opposite spatial
        directions: the two joint origins are ANTIPARALLEL (yaw -1.5708 vs
        +1.5708) and both axes are the local +X, so equal positive joint values
        already open the jaws symmetrically. A -1.0 multiplier would drive one jaw
        out of its [0, 0.0715] limit immediately.
      -->
    <mimic joint="gripper_joint1" multiplier="1.0" offset="0.0"/>
  </joint>
  <!-- Mechanical mount on the wrist. Massless frame; the physical bracket's
         collision volume is represented in the XRDF spheres, not here. -->
  <link name="camera_mount"/>
  <joint name="camera_mount_joint" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.05 0.0 0.06"/>
    <parent link="link6"/>
    <child link="camera_mount"/>
  </joint>
  <!-- Camera body frame. Identity w.r.t. the mount in the sim profile; the
         hand-eye result makes it non-identity on real hardware. -->
  <link name="camera_link"/>
  <joint name="camera_link_joint" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    <parent link="camera_mount"/>
    <child link="camera_link"/>
  </joint>
  <!-- Colour optical frame: the parent of CameraInfo and of every published
         pose from FoundationPose. -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0.0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
  </joint>
  <!-- Depth optical frame. Coincident with colour because both the sim camera
         and a D435 in aligned-depth mode register depth into the colour frame.
         Kept as a distinct frame so consumers that ask for the depth parent get a
         valid answer instead of a TF lookup failure. -->
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="camera_color_optical_frame"/>
    <child link="camera_depth_optical_frame"/>
  </joint>
