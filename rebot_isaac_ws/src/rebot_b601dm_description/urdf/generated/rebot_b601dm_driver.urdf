      <mass value="0.0187271664583674"/>
      <inertia ixx="4.42801172036323E-06" ixy="1.26927907319828E-13" ixz="-1.52049684129749E-10" iyy="4.37712746743999E-06" iyz="-2.5907655197107E-13" izz="8.55249688102954E-06"/>
