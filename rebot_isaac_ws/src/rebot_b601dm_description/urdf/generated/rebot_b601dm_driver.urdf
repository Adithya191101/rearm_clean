  <!--
      joint6 origin is the WITH-GRIPPER value (0.023692), which is the canonical
      one. Seeed's fixend URDF uses 0.028008 paired with a 0.15539 end offset;
      those two cancel to within 4 um of this model's 0.023692 + 0.15971, because
      the joint6 origin delta rotates onto link6 -Z through rpy=(0, 1.5708, 0).
      The real difference between the two upstream models is a 180-degree flip
      about X, not a translation — see docs/KDR-001-kinematic-frames.md.
    -->
  <joint name="joint6" type="revolute">
    <origin rpy="0 1.5708 0" xyz="0.023692 0 0.04"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit effort="7" lower="-3.14" upper="3.14" velocity="3.0"/>
  </joint>
  <!--
    Intermediate frame carrying the gripper-body transform. Present so the chain
    is built from the same two primitives as the full model instead of a
    pre-multiplied constant. Fixed joints do not contribute to nq.
  -->
  <link name="gripper_link"/>
  <joint name="gripper_joint" type="fixed">
    <origin rpy="0 -1.5708 0" xyz="0 0 0.15971"/>
    <parent link="link6"/>
    <child link="gripper_link"/>
  </joint>
  <!-- The SDK's end_effector_frame. Pose-identical to the full model's
       gripper_tcp by construction. -->
  <link name="end_link"/>
  <joint name="end_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.0443 0 0"/>
    <parent link="gripper_link"/>
    <child link="end_link"/>
  </joint>
  <!--
    gripper_tcp is also exposed here, coincident with end_link, so code written
    against the canonical name resolves in both models. Again fixed, so nq == 6.
  -->
  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="end_link"/>
    <child link="gripper_tcp"/>
  </joint>
</robot>
