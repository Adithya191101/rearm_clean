<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rebot_b601dm_perception</name>
  <version>0.1.0</version>
  <description>
    ROS-free soup-can grasp geometry for the reBot B601-DM Isaac ROS workflow.
    Runtime perception is owned by NVIDIA's Isaac Manipulator workflow.
  </description>
  <maintainer email="rebot-dev@example.invalid">reBot Isaac integration</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
